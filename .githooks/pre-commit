#!/bin/sh
# ---------------------------------------------------------------------------
# Git pre-commit hook — Quick audit (--quick) for early detection.
#
# Runs audit.py in quick mode (without node --check) so structural errors are
# caught before commit. The final gate remains pre-push / CI, which runs the
# full audit (14 checks).
#
# How to enable (once, from the repo root):
#     git config core.hooksPath .githooks
#     chmod +x .githooks/pre-commit
#
# How to disable:
#     git config --unset core.hooksPath
# ---------------------------------------------------------------------------
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "[pre-commit] Running quick audit (--quick)..."
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "[pre-commit] ERROR: Python 3 not found. Commit BLOCKED."
    exit 1
fi

if "$PYTHON" audit.py --quick; then
    echo "[pre-commit] OK — quick audit passed. Commit allowed."
else
    echo "[pre-commit] FAILED — quick audit found issues. Commit BLOCKED."
    exit 1
fi
