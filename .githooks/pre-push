#!/bin/sh
# ---------------------------------------------------------------------------
# Git pre-push hook — Pre-Flight Audit gate (15/15 PASS required).
#
# Rejects the push if audit.py finds issues (exit code != 0). Applies to every
# push to any remote (any branch).
#
# How to enable (once, from the repo root):
#     git config core.hooksPath .githooks
#     chmod +x .githooks/pre-push
#
# How to disable:
#     git config --unset core.hooksPath
# ---------------------------------------------------------------------------
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "[pre-push] Running pre-flight audit (must be 15/15 PASS)..."
# Prefer python3 (audit.py uses Python 3 syntax; 'python' on some older
# systems still points to Python 2, which would fail with a misleading error).
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "[pre-push] ERROR: Python 3 not found. Push BLOCKED."
    exit 1
fi

if "$PYTHON" audit.py; then
    echo "[pre-push] OK — audit passed. Push allowed."
else
    echo "[pre-push] FAILED — audit found issues. Push BLOCKED."
    echo "[pre-push] Fix the issues above before pushing again."
    exit 1
fi
